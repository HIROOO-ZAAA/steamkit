# StreamKit Environment Variables Example
# Copy this file to .env.local and fill in your Supabase credentials

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_publishable_key

# Server-only Payment Gateway Secrets (Keep confidential!)
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

# Provider abstraction
PAYMENT_PROVIDER=placeholder
PAYMENT_PROVIDER_SECRET=replace_with_provider_secret
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret
PAYMENT_RETURN_URL=http://localhost:3000/pay/
PAYMENT_CANCEL_URL=http://localhost:3000/

BAKONG_ACCOUNT_ID=your_bakong_account_id
BAKONG_MERCHANT_NAME=your_payment_recipient_name
BAKONG_MERCHANT_CITY=Phnom Penh
# REQUIRED to confirm a payment. The three vars above only build a scannable
# QR; without this the donor's money moves but the tip is never recorded, and
# /status answers {"awaitingConfirmation": true} forever. Set it on Vercel
# too, not just here -- local .env.local does not reach the deployment.
BAKONG_API_TOKEN=replace_with_server_only_bakong_token
BAKONG_API_URL=https://api-bakong.nbc.gov.kh

# ABA PayWay sandbox/production credentials (server-only)
ABA_PAYWAY_ENV=sandbox
ABA_PAYWAY_MERCHANT_ID=replace_with_merchant_id
ABA_PAYWAY_API_KEY=replace_with_server_only_api_key
ABA_PAYWAY_SECRET_KEY=replace_with_server_only_secret_key
ABA_PAYWAY_CALLBACK_URL=http://localhost:3000/api/payments/webhook

# Optional integrations (server-only)
STRIPE_SECRET_KEY=replace_with_provider_secret
KHMER_TTS_API_KEY=replace_with_tts_key

# VoiceStudio voice cloning + alert read-aloud (server-only, self-hosted).
# Without VOICESTUDIO_BASE_URL, POST /api/voice-clones and /api/tts/synthesize
# both answer 503 and the overlay falls back to the browser's own speech voice.
# VOICESTUDIO_BASE_URL is the public URL of the instance (a reverse proxy or a
# Cloudflare tunnel — NOT localhost, which only exists on its own machine).
# VOICESTUDIO_SHARED_SECRET must equal that instance's OMNIVOICE_API_KEY and is
# sent as `Authorization: Bearer`. It is not optional decoration: VoiceStudio
# refuses any request addressed to a host name it does not recognise, and a
# tunnel name is never recognised, so a missing or mismatched value 403s every
# call. VOICESTUDIO_DEFAULT_VOICE_ID is the stock voice used when a creator has
# no consented clone, and the fallback when a clone fails to synthesise, so an
# alert speaks on time instead of falling silent. Its id comes from the bundled
# demo profile (GET /profiles on the instance) - there is no /v1/voices on
# VoiceStudio 0.5.7, and /v1/audio/speech is the synthesis endpoint.
VOICESTUDIO_BASE_URL=https://tts.example.com
VOICESTUDIO_SHARED_SECRET=replace_with_the_instances_OMNIVOICE_API_KEY
VOICESTUDIO_DEFAULT_VOICE_ID=demo0001

# Opt-in live integration tests. Never enable against a production database.
# Set RUN_FAN_POINTS_INTEGRATION=1 only in a disposable test project with the
# service-role key below. The test creates unique users and deletes only rows
# it created.
RUN_FAN_POINTS_INTEGRATION=0
