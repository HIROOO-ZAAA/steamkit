# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
credentials.json
credentials.*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# dev-server / bridge runtime logs (1.3 MB regenerated per run)
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Telegram listener session + config (secrets)
telegram-local-agent.json
telegram-local-session.enc
.vercel

# Python venv (would otherwise pull ~200 MB of site-packages into git)
.venv/

# Supabase CLI local state (holds project-ref + access tokens once linked)
supabase/.temp/

# --- Rex Desk / agent tooling (not project source) ---
.agents/
.ai-handoff/
.claude/
memory/
skills-lock.json

# --- Backup and scratch files ---
*.bak
*.bak-*
*.orig
*.tmp

# --- Audit / investigation reports (working docs, not source) ---
SECURITY_AUDIT_REPORT_*.md
SECURITY_AUDIT_VALIDATION_*.md
SECURITY_H02_LIVE_VERIFICATION_*.md
SECURITY_REMEDIATION_PREFLIGHT_*.md
STREAMKIT_AUDIT_REPORT_*.md
