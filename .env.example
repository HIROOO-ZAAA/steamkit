# Public Supabase project configuration. Use the project URL and publishable key
# from the Supabase dashboard. The anon key name remains supported for older setups.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redis is used by the optional realtime bridge. In Docker, Compose supplies
# redis://redis:6379 automatically to the web and bridge services.
REDIS_URL=redis://localhost:6379

# Server-only Supabase credential. Never use a NEXT_PUBLIC_ name for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Local payment provider. Replace placeholder with bakong or aba_payway when
# the corresponding merchant configuration is ready; never use placeholder in production.
PAYMENT_PROVIDER=placeholder
PAYMENT_WEBHOOK_SECRET=

# ABA PayWay. Currency-specific settings below override these shared values.
ABA_PAYWAY_ENV=sandbox
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_SECRET_KEY=
ABA_PAYWAY_API_URL=
ABA_PAYWAY_CALLBACK_URL=
ABA_PAYWAY_USD_MERCHANT_ID=
ABA_PAYWAY_USD_API_KEY=
ABA_PAYWAY_USD_SECRET_KEY=
ABA_PAYWAY_USD_API_URL=
ABA_PAYWAY_KHR_MERCHANT_ID=
ABA_PAYWAY_KHR_API_KEY=
ABA_PAYWAY_KHR_SECRET_KEY=
ABA_PAYWAY_KHR_API_URL=

# Bakong KHQR generation and transaction verification.
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
BAKONG_API_TOKEN=
BAKONG_API_URL=

# Telegram local bridge and bot integration.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TOKEN_SECRET=
TELEGRAM_WEBHOOK_SECRET=
KIT_CLIENT_PORT=3113
KIT_CLIENT_ALLOWED_ORIGINS=http://localhost:3000

# Voice synthesis providers. Keep all credentials server-side.
VOICESTUDIO_BASE_URL=
VOICESTUDIO_SHARED_SECRET=
VOICESTUDIO_DEFAULT_VOICE_ID=
ELEVENLABS_API_KEY=

# Optional local voice transcription model snapshot path.
WHISPER_SNAPSHOT=
